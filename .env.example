# CORE API key (get from https://core.ac.uk/api-keys)
CORE_API_KEY=

# Cloud LLM — Groq (Recommended for identical Local & Render behavior, free at https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cloud LLM — OpenAI (Optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local LLM — Ollama (Local development only — https://ollama.com)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

FLASK_DEBUG=true
